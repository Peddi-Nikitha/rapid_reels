{
  "name": "functions",
  "description": "Cloud Functions for Rapid Reels",
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "migrate:inr-gbp:dry": "node scripts/migrate_inr_to_gbp.js --dryRun",
    "migrate:inr-gbp": "node scripts/migrate_inr_to_gbp.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "dotenv": "^17.3.1",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "nodemailer": "^8.0.4",
    "pdfkit": "^0.18.0",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}
